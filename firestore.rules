rules_version = '2';

// =====================================================================
// ⚠️  ATENÇÃO — REGRAS PERMISSIVAS PARA DESENVOLVIMENTO LOCAL ⚠️
// ---------------------------------------------------------------------
//  Esta versão das regras LIBERA leitura e escrita de TODA a base.
//  Foi escrita para o uso EXCLUSIVO com o Firestore Emulator durante a
//  Release 1 (Core), enquanto Auth ainda não foi integrado.
//
//  NÃO faça deploy destas regras em produção.
//
//  Na Release 2 (Qualidade) estas regras serão substituídas por:
//    - allow read, write: if request.auth != null
//        && request.auth.uid == resource.data.userId;
//  ou seja, cada usuário só enxerga e altera as próprias tarefas.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
